<UserControl x:Class="LogLens.App.Views.EntryExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:local="clr-namespace:LogLens.App.Views"
             xmlns:parsing="clr-namespace:LogLens.Core.Parsing;assembly=LogLens.Core">
    <UserControl.Resources>
        <local:EntryPreviewConverter x:Key="EntryPreviewConverter" />

        <Style x:Key="ExplorerInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SeverityCheckStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,18,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="ExplorerListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Padding="14,10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F7F8FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,30,36,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Entry explorer" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Search and filter the already-parsed entries. No source file is reopened." />
        </StackPanel>

        <Border x:Name="NoFilePanel"
                Grid.Row="1"
                MaxWidth="520"
                Margin="0,28,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}">
            <StackPanel Margin="22" HorizontalAlignment="Center">
                <Border Width="64" Height="64" Background="{DynamicResource AccentSoftBrush}" CornerRadius="32">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="25"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="≡" />
                </Border>
                <TextBlock Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="No entries loaded" />
                <TextBlock Margin="0,8,0,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Open a .log or .txt file from Home to explore its normalised entries."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid x:Name="ExplorerPanel"
              Grid.Row="1"
              Margin="0,22,0,0"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="18,15" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SearchLabel"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Search raw log text" />
                <TextBox x:Name="SearchTextBox"
                                 Grid.Row="1"
                                 Margin="0,6,0,0"
                                 Style="{StaticResource ExplorerInputStyle}"
                                 automation:AutomationProperties.Name="Search raw log text"
                                 automation:AutomationProperties.HelpText="Case-insensitive local substring search"
                                 SpellCheck.IsEnabled="False"
                                 TextChanged="SearchTextBox_TextChanged" />

                        <TextBlock Grid.Column="2"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Timestamp" />
                        <ComboBox x:Name="TimestampFilterComboBox"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  Height="38"
                                  Margin="0,6,0,0"
                                  Padding="9,5"
                                  VerticalContentAlignment="Center"
                                  automation:AutomationProperties.Name="Timestamp presence filter"
                                  SelectedIndex="0"
                                  SelectionChanged="TimestampFilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="All entries" Tag="All" />
                            <ComboBoxItem Content="Has timestamp" Tag="HasTimestamp" />
                            <ComboBoxItem Content="No timestamp" Tag="NoTimestamp" />
                        </ComboBox>

                        <Button Grid.Row="1"
                                Grid.Column="4"
                                MinWidth="106"
                                Margin="0,6,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                automation:AutomationProperties.Name="Clear all entry filters"
                                Click="ClearFiltersButton_Click"
                                Content="Clear filters" />
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Margin="0,0,0,7"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Severity" />
                        <WrapPanel>
                            <CheckBox x:Name="AllSeveritiesCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show all severities"
                                      Click="AllSeveritiesCheckBox_Click"
                                      Content="All severities"
                                      IsChecked="True" />
                            <CheckBox x:Name="TraceCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show trace entries"
                                      Click="SeverityCheckBox_Click"
                                      Content="Trace" />
                            <CheckBox x:Name="DebugCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show debug entries"
                                      Click="SeverityCheckBox_Click"
                                      Content="Debug" />
                            <CheckBox x:Name="InformationCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show information entries"
                                      Click="SeverityCheckBox_Click"
                                      Content="Information" />
                            <CheckBox x:Name="WarningCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show warning entries"
                                      Click="SeverityCheckBox_Click"
                                      Content="Warning" />
                            <CheckBox x:Name="ErrorCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show error entries"
                                      Click="SeverityCheckBox_Click"
                                      Content="Error" />
                            <CheckBox x:Name="CriticalCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show critical and fatal entries"
                                      Click="SeverityCheckBox_Click"
                                      Content="Critical / Fatal" />
                            <CheckBox x:Name="UnknownCheckBox"
                                      Style="{StaticResource SeverityCheckStyle}"
                                      automation:AutomationProperties.Name="Show unclassified entries"
                                      Click="SeverityCheckBox_Click"
                                      Content="Unclassified" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="2,12,2,10">
                <TextBlock x:Name="ResultCountText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           automation:AutomationProperties.LiveSetting="Polite"
                           Text="Showing 0 of 0 parsed entries" />
                <TextBlock x:Name="SourceContextText"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="0"
                        ClipToBounds="True"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="14,0"
                                Background="#F7F8FB"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="LINE" />
                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="TIMESTAMP" />
                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="SEVERITY" />
                                <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="MESSAGE PREVIEW" />
                            </Grid>
                        </Border>

                        <ListBox x:Name="EntriesListBox"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource ExplorerListItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 automation:AutomationProperties.Name="Filtered log entries"
                                 SelectionChanged="EntriesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="108" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding LineNumber, StringFormat={}{0:N0}}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding Timestamp.RawText, TargetNullValue=—}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Severity}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static parsing:LogSeverity.Information}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static parsing:LogSeverity.Warning}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static parsing:LogSeverity.Error}">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static parsing:LogSeverity.Critical}">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{Binding Converter={StaticResource EntryPreviewConverter}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="Select this entry to inspect its details." />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="NoMatchesPanel"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="No matching entries" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="No log entries match the current filters."
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="20" Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel x:Name="NoSelectionPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Select an entry" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Use the list or arrow keys to inspect the original text."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="EntryDetailsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Selected entry" />

                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="LINE NUMBER" />
                                    <TextBlock x:Name="DetailLineNumberText" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="SEVERITY" />
                                    <TextBlock x:Name="DetailSeverityText" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,13,0,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="PARSED TIMESTAMP" />
                                <TextBlock x:Name="DetailTimestampText"
                                           Margin="0,4,0,0"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,13,0,10">
                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="LINE DIAGNOSTICS" />
                                <TextBlock x:Name="DetailDiagnosticsText"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="ORIGINAL RAW TEXT" />
                                <TextBox x:Name="DetailRawTextBox"
                                         Grid.Row="1"
                                         Margin="0,6,0,0"
                                         Padding="10"
                                         AcceptsReturn="True"
                                         Background="#F8F9FC"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         automation:AutomationProperties.Name="Selected entry original raw text"
                                         automation:AutomationProperties.HelpText="Inert read-only text; links and commands are not opened or executed" />
                            </Grid>

                            <TextBlock x:Name="DetailLimitNoticeText"
                                       Grid.Row="5"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
