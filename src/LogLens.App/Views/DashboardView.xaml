<UserControl x:Class="LogLens.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="52,44,52,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Dashboard" />
                <TextBlock x:Name="DashboardSubtitleText"
                           Style="{StaticResource PageSubtitleStyle}"
                           Text="Summary statistics will appear here after a file is opened." />
            </StackPanel>

            <Border x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    MaxWidth="520"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CardStyle}">
                <StackPanel Margin="22" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" Background="{DynamicResource AccentSoftBrush}" CornerRadius="32">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="—" />
                    </Border>
                    <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="No file loaded" />
                    <TextBlock Margin="0,8,0,0" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Open a .log or .txt file from Home to view its parsing summary." TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="AnalysisPanel"
                        Grid.Row="1"
                        Margin="0,30,0,0"
                        Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="PARSED SOURCE" />
                            <TextBlock x:Name="FileNameText"
                                       Margin="0,6,0,0"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SourceDetailText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="11,6" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="14">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#167A53" Text="Opened read-only" />
                            </Border>
                            <Border Margin="8,0,0,0" Padding="11,6" Background="{DynamicResource AccentSoftBrush}" CornerRadius="14">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="Parsed locally" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Total entries" />
                            <TextBlock x:Name="TotalEntriesText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Information" />
                            <TextBlock x:Name="InformationCountText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Warnings" />
                            <TextBlock x:Name="WarningCountText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Errors" />
                            <TextBlock x:Name="ErrorCountText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Critical / Fatal" />
                            <TextBlock x:Name="CriticalCountText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Debug / Trace" />
                            <TextBlock x:Name="DebugTraceCountText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Unclassified" />
                            <TextBlock x:Name="UnclassifiedCountText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="6" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="With timestamps" />
                            <TextBlock x:Name="TimestampedCountText" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Parsing status" />
                        <TextBlock x:Name="ParsingStatusText"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceIntegrityText"
                                   Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
