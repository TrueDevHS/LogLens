<UserControl x:Class="LogLens.App.Views.PatternsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:local="clr-namespace:LogLens.App.Views">
    <UserControl.Resources>
        <local:EntryPreviewConverter x:Key="EntryPreviewConverter" />

        <Style x:Key="PatternListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="automation:AutomationProperties.HelpText" Value="{Binding Explanation}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FindingBorder"
                                Padding="14,11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FindingBorder" Property="Background" Value="#F7F8FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FindingBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FindingBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EvidenceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding LineNumber, StringFormat=Supporting entry line {0:N0}}" />
            <Setter Property="automation:AutomationProperties.HelpText" Value="Select to inspect this entry as inert text" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="EvidenceBorder"
                                Margin="0,0,0,4"
                                Padding="9,7"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EvidenceBorder" Property="Background" Value="#F7F8FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="EvidenceBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FindingTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,4,10,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               MaxHeight="34"
                               Text="{Binding Explanation}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        MinWidth="34"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="10">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding OccurrenceCount, StringFormat={}{0:N0}}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Patterns" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Deterministic repeated-message, severity-burst and time-window analysis with traceable evidence." />
        </StackPanel>

        <Border x:Name="NoFilePanel"
                Grid.Row="1"
                MaxWidth="520"
                Margin="0,28,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}">
            <StackPanel Margin="22" HorizontalAlignment="Center">
                <Border Width="64" Height="64" Background="{DynamicResource AccentSoftBrush}" CornerRadius="32">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="25"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="≋" />
                </Border>
                <TextBlock Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="No patterns to show" />
                <TextBlock Margin="0,8,0,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Open a .log or .txt file from Home to analyse its already-normalised entries."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border x:Name="LoadingPanel"
                Grid.Row="1"
                MaxWidth="520"
                Margin="0,28,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
            <StackPanel Margin="24" HorizontalAlignment="Center">
                <ProgressBar x:Name="AnalysisProgressBar" Width="220" Height="4" IsIndeterminate="True" />
                <TextBlock x:Name="LoadingTitleText"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Analysing patterns locally" />
                <TextBlock x:Name="LoadingMessageText"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Using the parsed entries already held in memory." />
            </StackPanel>
        </Border>

        <Grid x:Name="AnalysisPanel"
              Grid.Row="1"
              Margin="0,18,0,0"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="16,13" Style="{StaticResource CardStyle}">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="ENTRIES ANALYSED" />
                        <TextBlock x:Name="EntriesAnalyzedText" Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="REPEATED PATTERNS" />
                        <TextBlock x:Name="RepeatCountText" Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="SEVERITY BURSTS" />
                        <TextBlock x:Name="BurstCountText" Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="TIMED ENTRIES USED" />
                        <TextBlock x:Name="TimedEntryCountText" Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeAnalysisStatusText"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SeverityDistributionText"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <Border Padding="0" ClipToBounds="True" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="15,12,15,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SourceContextText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BoundedResultsText"
                                       Grid.Row="1"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <TabControl Grid.Row="1"
                                    BorderThickness="0,1,0,0"
                                    automation:AutomationProperties.Name="Pattern finding categories">
                            <TabItem Header="Repeated messages">
                                <Grid>
                                    <ListBox x:Name="RepeatedFindingsListBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ItemContainerStyle="{StaticResource PatternListItemStyle}"
                                             ItemTemplate="{StaticResource FindingTemplate}"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             automation:AutomationProperties.Name="Repeated message findings"
                                             SelectionChanged="FindingListBox_SelectionChanged" />
                                    <TextBlock x:Name="NoRepeatedPatternsText"
                                               Margin="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="No repeated message patterns detected."
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Severity bursts">
                                <Grid>
                                    <ListBox x:Name="BurstFindingsListBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ItemContainerStyle="{StaticResource PatternListItemStyle}"
                                             ItemTemplate="{StaticResource FindingTemplate}"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             automation:AutomationProperties.Name="Severity burst findings"
                                             SelectionChanged="FindingListBox_SelectionChanged" />
                                    <TextBlock x:Name="NoBurstsText"
                                               Margin="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="No severity bursts detected."
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Activity windows">
                                <Grid>
                                    <ListBox x:Name="ActivityFindingsListBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ItemContainerStyle="{StaticResource PatternListItemStyle}"
                                             ItemTemplate="{StaticResource FindingTemplate}"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             automation:AutomationProperties.Name="Activity window findings"
                                             SelectionChanged="FindingListBox_SelectionChanged" />
                                    <TextBlock x:Name="NoActivityWindowsText"
                                               Margin="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="17" Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel x:Name="NoFindingSelectionPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Select a finding" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Use a finding list or the arrow keys to inspect its evidence."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="FindingDetailsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="110" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="FindingTitleText"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="FindingExplanationText"
                                       Grid.Row="1"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Grid Grid.Row="2" Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Text="SEVERITY / TYPE" />
                                    <TextBlock x:Name="FindingTypeText" Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Text="TIME / RANGE" />
                                    <TextBlock x:Name="FindingTimeText" Margin="0,3,0,0" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="EvidenceCountText"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           automation:AutomationProperties.LiveSetting="Polite" />
                                <ListBox x:Name="EvidenceListBox"
                                         Grid.Row="1"
                                         Margin="0,5,0,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemContainerStyle="{StaticResource EvidenceListItemStyle}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         automation:AutomationProperties.Name="Supporting log entries"
                                         SelectionChanged="EvidenceListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding LineNumber, StringFormat=Line {0:N0}}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="0,0,7,0"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Severity}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="{Binding Converter={StaticResource EntryPreviewConverter}}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Button x:Name="OpenEvidenceButton"
                                    Grid.Row="4"
                                    Margin="0,7,0,7"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    automation:AutomationProperties.Name="View selected evidence in Entries"
                                    automation:AutomationProperties.HelpText="Opens the selected in-memory entry in the existing Entry Explorer and clears its filters"
                                    Click="OpenEvidenceButton_Click"
                                    Content="View in Entries"
                                    IsEnabled="False" />

                            <TextBox x:Name="EvidenceRawTextBox"
                                     Grid.Row="5"
                                     Padding="9"
                                     AcceptsReturn="True"
                                     Background="#F8F9FC"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     automation:AutomationProperties.Name="Selected evidence original raw text"
                                     automation:AutomationProperties.HelpText="Inert read-only text; links and commands are not opened or executed" />

                            <TextBlock x:Name="EvidenceLimitNoticeText"
                                       Grid.Row="6"
                                       Margin="0,6,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
