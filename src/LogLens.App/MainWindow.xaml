<Window x:Class="LogLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="LogLens"
        Width="1240"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="12"
                            Background="{DynamicResource AccentBrush}">
                        <Viewbox Width="25" Height="25">
                            <Canvas Width="36" Height="36">
                                <Ellipse Canvas.Left="3"
                                         Canvas.Top="3"
                                         Width="22"
                                         Height="22"
                                         Stroke="White"
                                         StrokeThickness="3" />
                                <Line X1="21"
                                      Y1="21"
                                      X2="33"
                                      Y2="33"
                                      Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="LogLens" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SidebarMutedTextBrush}"
                                   Text="LOCAL LOG ANALYSIS" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,42,0,0">
                    <TextBlock Margin="12,0,0,10"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarMutedTextBrush}"
                               Text="WORKSPACE" />

                    <RadioButton x:Name="HomeNavigationButton"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Content="Home"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Tag="Home"
                                 Click="NavigationButton_Click" />
                    <RadioButton x:Name="DashboardNavigationButton"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Content="Dashboard"
                                 GroupName="Navigation"
                                 Tag="Dashboard"
                                 Click="NavigationButton_Click" />
                    <RadioButton x:Name="EntriesNavigationButton"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Content="Entries"
                                 GroupName="Navigation"
                                 Tag="Explorer"
                                 Click="NavigationButton_Click" />
                    <RadioButton x:Name="PatternsNavigationButton"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Content="Patterns"
                                 GroupName="Navigation"
                                 Tag="Patterns"
                                 Click="NavigationButton_Click" />

                    <TextBlock Margin="12,26,0,10"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarMutedTextBrush}"
                               Text="INFORMATION" />
                    <RadioButton x:Name="AboutNavigationButton"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Content="About &amp; Privacy"
                                 GroupName="Navigation"
                                 Tag="About"
                                 Click="NavigationButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <TextBlock x:Name="LocalSessionStatusText"
                               Margin="4,0,4,10"
                               MaxHeight="50"
                               FontSize="11"
                               Foreground="{DynamicResource SidebarMutedTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="ExportSummaryButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            automation:AutomationProperties.Name="Export Summary"
                            automation:AutomationProperties.HelpText="Choose a separate local TXT or JSON destination for a bounded analysis summary"
                            Click="ExportSummaryButton_Click"
                            Content="Export Summary"
                            IsEnabled="False" />
                    <TextBlock x:Name="ExportStatusText"
                               Margin="4,8,4,0"
                               MaxHeight="34"
                               FontSize="11"
                               Foreground="{DynamicResource SidebarMutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <Border Grid.Row="4"
                        Padding="14"
                        Background="#162238"
                        CornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="100% Local Processing" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarMutedTextBrush}"
                                   Text="No uploads, accounts or telemetry."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContent"
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
